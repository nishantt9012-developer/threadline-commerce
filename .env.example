# Copy this file to `.env` (it is git-ignored). The API loads it automatically on start.
# Real environment variables take priority over values in this file.
API_PORT=3001

# Razorpay TEST keys (https://dashboard.razorpay.com). Leave empty to run with Cash on Delivery only.
# These are read by the Node API only - never prefix them with VITE_ and never put them in React code.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Transactional email (server-only). Leave blank to disable. Never use a VITE_ prefix.
RESEND_API_KEY=
EMAIL_FROM=
ORDER_NOTIFY_EMAIL=
EMAIL_REPLY_TO=
